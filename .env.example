PORT=5080
HOST=0.0.0.0
DATA_DIR=./data

# Client-facing API key (embedded in desktop app via appsettings.local.json)
CLIENT_API_KEY=change-me-client-key

# Admin/ops key (separate from client key; optional, defaults to CLIENT_API_KEY)
# ADMIN_API_KEY=change-me-admin-key

# Legacy alias — used if CLIENT_API_KEY is unset
# API_KEY=change-me-to-a-secret-key

# Require HMAC request signing from registered clients (default: true in production)
# Device registration is for request authentication only — balance follows summoner name.
REQUIRE_CLIENT_SIGNATURE=true
CLIENT_SIGNATURE_SKEW_MS=300000

# PostgreSQL (Render: δημιούργησε Postgres DB και σύνδεσέ το στο Web Service)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Per-user Tron wallets (private keys encrypted at rest)
WALLET_ENCRYPTION_KEY=

# USDT TRC-20 deposits (per-user wallets scanned via TronGrid)
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRONGRID_API_KEY=
DEPOSIT_EXPIRY_MINUTES=60
DEPOSIT_MONITOR_INTERVAL_MS=30000
# Faster when pending deposits exist; slower when none (saves TronGrid RPC)
DEPOSIT_MONITOR_ACTIVE_INTERVAL_MS=25000
DEPOSIT_MONITOR_IDLE_INTERVAL_MS=90000
TRONGRID_RETRY_MAX_ATTEMPTS=3
TRONGRID_RETRY_BASE_MS=4000
MIN_DEPOSIT_USDT=10
MAX_DEPOSIT_USDT=10000
